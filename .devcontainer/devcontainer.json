{
  "name": "Mido Accounting Development",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [1521, 5500],
  "portsAttributes": {
    "1521": { "label": "Oracle Database", "onAutoForward": "silent" },
    "5500": { "label": "Oracle EM", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "ms-vscode.vscode-json"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2
      }
    }
  },
  "remoteUser": "node"
}
