{
  "name": "onyx-accounting-desktop",
  "version": "0.1.0",
  "description": "نظام أونكس المحاسبي - تطبيق سطح مكتب عربي شامل",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win"
  },
  "author": "Onyx Accounting",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.onyx.accounting",
    "productName": "أونكس المحاسبي",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
